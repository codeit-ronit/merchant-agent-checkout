# SENTINEL — .gitignore
# Test-mode keys ONLY are ever used, and they are injected via environment,
# never committed. This file is defence-in-depth, not the primary control
# (see .gitleaks.toml + CI secret scan).

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# environment / secrets — never commit
.env
.env.*
!.env.example
*.key
secrets.*

# node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# local runtime state (the ledger, token store, governor counters, approvals db)
# The demo regenerates these deterministically; they are not committed.
*.db
*.db-journal
*.db-wal
*.db-shm
sentinel_state/
.DS_Store

# Cassettes: only the eval cassettes are committed (guardrails-ON, PII-clean) so
# `SENTINEL_CASSETTE=replay make eval` reproduces the numbers with no API key.
# The red-team/api/demo cassettes are NOT committed: they are regenerated offline
# by the deterministic agent brains each run (no network), and the guardrails-OFF
# red-team recordings deliberately capture the exfiltration counterfactual, so they
# contain synthetic-PII-shaped strings we keep out of version control.
cassettes/redteam/
cassettes/api/
cassettes/demo/
# artifacts/ ARE committed on purpose (reference manifest + eval/redteam results).
