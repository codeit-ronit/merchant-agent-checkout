# SENTINEL — environment template. Copy to .env and fill in for LIVE/RECORD modes.
# The demo, tests, evals, and red-team ALL run with NONE of these set,
# because fixture mode + cassette replay need no network and no credentials.

# ---- Mode switching (the only knobs the demo needs) ----
# fixture (default) = deterministic in-process upstream; live = real Razorpay MCP (TEST keys only)
SENTINEL_MODE=fixture
# replay (default for CI) | record | auto (dev). replay uses zero network.
SENTINEL_CASSETTE=replay

# ---- Razorpay MCP server (LIVE mode only) ----
# TEST-MODE KEYS ONLY. A key beginning rzp_live_ is rejected at startup.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Inference providers (RECORD mode only; replay/fixture need nothing) ----
# Providers, models, and rate limits live in config/providers.yaml (verified + dated).
# Only the secrets belong here.
SENTINEL_PROVIDER_A_API_KEY=
SENTINEL_PROVIDER_B_API_KEY=
